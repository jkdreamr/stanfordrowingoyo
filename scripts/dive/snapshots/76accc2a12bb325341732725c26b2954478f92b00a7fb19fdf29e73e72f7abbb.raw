{"publishers": ["Amulet Books"], "description": {"type": "/type/text", "value": "Sammy wants to be a musician, as was his grandfather, but while the band he is in is self-destructing, Sammy is too distracted by his grandfather's decline and confused feelings about his best friend to fix it--and his mother stays too busy to help."}, "pagination": "p. cm.", "covers": [8198922], "lc_classifications": ["PZ7.S628393 Str 2009", "PZ7.S628393Str 2009"], "key": "/books/OL22679131M", "authors": [{"key": "/authors/OL6508370A"}], "ocaid": "strutsfrets0000skov", "publish_places": ["New York"], "isbn_13": ["9780810941748"], "genres": ["Fiction."], "source_records": ["marc:marc_loc_updates/v36.i46.records.utf8:7057610:1021", "marc:marc_loc_updates/v38.i05.records.utf8:6407992:1043", "marc:marc_loc_updates/v38.i15.records.utf8:6671591:1043", "ia:strutsfrets0000skov", "bwb:9780810941748", "marc:marc_loc_2016/BooksAll.2016.part35.utf8:149941500:1043", "promise:bwb_daily_pallets_2022-08-30"], "title": "Struts and frets", "dewey_decimal_class": ["[Fic]"], "identifiers": {"goodreads": ["6213802"], "librarything": ["8212423"], "amazon": ["B000X99H4S"], "better_world_books": ["BWB19690089"]}, "languages": [{"key": "/languages/eng"}], "lccn": ["2008045925"], "subjects": ["Bands (Music) -- Fiction", "Self-confidence -- Fiction", "Interpersonal relations -- Fiction", "Grandfathers -- Fiction", "Single-parent families -- Fiction", "Columbus (Ohio) -- Fiction"], "publish_date": "2009", "publish_country": "nyu", "by_statement": "by Jon Skovron.", "oclc_numbers": ["272304005"], "works": [{"key": "/works/OL13652412W"}], "type": {"key": "/type/edition"}, "local_id": ["urn:bwbsku:O8-AUV-819"], "latest_revision": 13, "revision": 13, "created": {"type": "/type/datetime", "value": "2008-12-12T07:55:44.759325"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-04T13:47:55.908794"}}