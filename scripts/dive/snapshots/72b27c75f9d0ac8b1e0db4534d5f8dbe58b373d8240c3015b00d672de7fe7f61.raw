{"type": {"key": "/type/edition"}, "publish_date": "2010", "publish_country": "xxu", "languages": [{"key": "/languages/eng"}], "authors": [{"key": "/authors/OL7312148A"}], "oclc_numbers": ["793401226"], "dewey_decimal_class": ["[Fic]"], "description": {"type": "/type/text", "value": "After defending herself against fairy magic, Jolie Wilkins wakes to find her world turned upside down -- the creatures of the Underworld on the precipice of war. The Underworld is polarized in a battle of witch against witch, creature against creature, led by the villainous Bella, who would be Queen. While Jolie has one goal in mind -- to stake the vampire, Ryder, who nearly killed her, she also must choose between the affections of her warlock employer, Rand, and the mysteriously sexy vampire, Sinjin. And as if that weren't enough to ruin a girl's day, everything Jolie knows will be turned inside out when she's thrust into the shock of a lifetime."}, "subjects": ["Witches", "Fiction", "Warlocks", "Vampires"], "title": "Toil and trouble", "subtitle": "Book 2 of the Jolie Wilkins series", "by_statement": "HP Mallory", "publishers": ["[publisher not identified]"], "publish_places": ["[United States]"], "isbn_13": ["9781470093556"], "isbn_10": ["1470093553"], "pagination": "234 pages", "number_of_pages": 234, "ocaid": "toiltroublebook20000mall", "source_records": ["ia:toiltroublebook20000mall", "promise:bwb_daily_pallets_2020-08-06", "bwb:9781470093556"], "full_title": "Toil and trouble Book 2 of the Jolie Wilkins series", "covers": [10814332], "works": [{"key": "/works/OL24303187W"}], "key": "/books/OL32147866M", "local_id": ["urn:bwbsku:O5-PLK-108"], "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2021-03-28T05:15:50.301903"}, "last_modified": {"type": "/type/datetime", "value": "2024-09-19T21:22:08.267151"}}