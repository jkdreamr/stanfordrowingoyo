{
  "name": "stanford-oyo",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "worker",
    "web"
  ],
  "scripts": {
    "dev": "npm run build -w web && concurrently -k \"wrangler dev\" \"npm run dev -w web\"",
    "build": "npm run build -w web && wrangler deploy --dry-run",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy": "npm run build -w web && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "concurrently": "^9.2.1",
    "@cloudflare/workers-types": "^5.20261104.1"
  }
}
