{
  "name": "stanford-oyo",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TEAM",
        "class_name": "TeamDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TeamDO"
      ]
    }
  ]
}
